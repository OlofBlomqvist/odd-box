# Alpine is musl-native, so we get a genuine static-friendly musl binary
# without any cross-compilation complexity.
#
# Supports two targets via the RUST_TARGET build arg:
#   x86_64-unknown-linux-musl   (default, native on amd64 runner)
#   aarch64-unknown-linux-musl  (native on arm64 runner / QEMU via --platform linux/arm64)
#
# NOTE: cruma-sdk is a symlink in the repository.  The build script
# resolves it to a real directory and passes two separate build contexts:
#
#   docker build \
#       --build-context cruma-sdk=<real-cruma-sdk-path> \
#       --build-arg RUST_TARGET=x86_64-unknown-linux-musl \
#       ...
#
# The Dockerfile references that second context with:
#   COPY --from=cruma-sdk . ./cruma-sdk/
#
ARG RUST_TARGET=x86_64-unknown-linux-musl

FROM rust:alpine AS builder

ARG RUST_TARGET

# ── System build dependencies ──────────────────────────────────────────────
#
# cmake + make + perl + g++  — required by aws-lc-rs (bundled C crypto)
# pkgconfig                  — used by many -sys crates
# musl-dev                   — musl headers / libc
#
# X11 group     — needed by iced/winit (X11 backend)
# Wayland group — needed by iced/winit (Wayland backend)
# fontconfig    — needed by iced font loading
# dbus-dev      — needed by ksni (Linux system tray)
# gtk+3.0-dev   — needed by rfd (native file-picker dialogs)
# openssl-dev   — needed by various -sys crates even when using rustls
RUN apk add --no-cache \
    # Build toolchain
    musl-dev \
    cmake \
    make \
    perl \
    pkgconfig \
    g++ \
    # X11 (iced / winit)
    libx11-dev \
    libxcursor-dev \
    libxrandr-dev \
    libxi-dev \
    libxinerama-dev \
    # Wayland (iced / winit)
    wayland-dev \
    libxkbcommon-dev \
    # Font rendering (iced)
    fontconfig-dev \
    # System tray (ksni via D-Bus)
    dbus-dev \
    # File-picker dialogs (rfd)
    gtk+3.0-dev \
    # OpenSSL headers (various -sys crates)
    openssl-dev

# ── Rust target ────────────────────────────────────────────────────────────
# rust:alpine ships the musl toolchain for the host arch by default; we add
# the requested target explicitly so the build is reproducible.
RUN rustup target add "${RUST_TARGET}"

# aws-lc-rs needs to find a C compiler for the target.
# When running natively (same arch as the Docker --platform) gcc is the right
# compiler for both x86_64 and aarch64 musl.
ENV CC=gcc
# Tell pkg-config not to complain about cross-root mismatches
ENV PKG_CONFIG_ALLOW_CROSS=1

# ── Source ─────────────────────────────────────────────────────────────────
WORKDIR /usr/src/odd-box

# Copy the main project files first (excluding cruma-sdk — it's a symlink
# in the repo and is injected via a separate --build-context below).
COPY . .

# Overlay the real cruma-sdk directory (resolved by the build script and
# passed in as a named build context so Docker never has to follow the
# symlink itself).
COPY --from=cruma-sdk . ./cruma-sdk/

# ── Build ──────────────────────────────────────────────────────────────────
RUN cargo build --release --target "${RUST_TARGET}" -p odd-box

# ── Minimal output image ───────────────────────────────────────────────────
FROM scratch AS export
ARG RUST_TARGET
COPY --from=builder \
    /usr/src/odd-box/target/${RUST_TARGET}/release/odd-box \
    /odd-box
